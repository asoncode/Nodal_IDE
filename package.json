{
  "name": "nodal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:ui": "vite --config apps/desktop/vite.config.ts",
    "runtime": "tsx packages/runtime/src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm typecheck && vite build --config apps/desktop/vite.config.ts && pnpm build:runtime",
    "desktop": "tsx scripts/desktop.ts dev",
    "test:e2e": "pnpm build && tsx scripts/e2e.ts",
    "verify:provider": "tsx scripts/verify-provider.ts",
    "build:runtime": "tsup --config tsup.config.ts",
    "stage:desktop": "tsx scripts/stage-desktop.ts",
    "desktop:build": "tsx scripts/desktop.ts build",
    "example": "tsx scripts/create-example.ts",
    "verify:bundle": "tsx scripts/verify-built-runtime.ts",
    "demo:quality-loop": "tsx scripts/demo-quality-loop.ts",
    "postinstall": "node scripts/prepare-pty.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@fontsource/fragment-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex-sdk": "^0.163.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.59.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
